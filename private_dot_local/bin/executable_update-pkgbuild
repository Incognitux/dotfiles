#!/usr/bin/bash
set -e

if [ -z "$1" ]; then
  echo "Usage: $0 <pkgbuild_dir>"
  exit 1
fi

TARGET_DIR="$1"

if [ ! -d "$TARGET_DIR" ]; then
  echo "Error: '$TARGET_DIR' does not exist."
  exit 1
fi

cd $TARGET_DIR

if [ ! -f "PKGBUILD" ]; then
  echo "Error: PKGBUILD not found in '$TARGET_DIR'."
  exit 1
fi

PKGNAME=$(source ./PKGBUILD && echo "$pkgname")

if [ ! -f "nvchecker.toml" ]; then
  echo "Error: nvchecker.toml not found in '$TARGET_DIR'."
  exit 1
fi

echo "Checking for updates..."
nvchecker -c nvchecker.toml

NEW_VER=$(nvcmp -c nvchecker.toml --json | jq -r ".[] | select(.name == \"$PKGNAME\") | .newver")

if [ -z "$NEW_VER" ] || [ "$NEW_VER" == "null" ]; then
  echo "No updates available for $PKGNAME."
  exit 0
fi

echo "Updating $PKGNAME to version $NEW_VER..."
sed -i "s/^pkgver=.*/pkgver=$NEW_VER/" PKGBUILD
sed -i "s/^pkgrel=.*/pkgrel=1/" PKGBUILD

echo "Downloading sources and updating checksums..."
updpkgsums

echo "Generating .SRCINFO..."
makepkg --printsrcinfo > .SRCINFO

echo "Starting clean chroot build test..."
if extra-x86_64-build; then
    nvtake -c nvchecker.toml "$PKGNAME"
    
    echo ""
    echo "================================================="
    echo "SUCCESS: Build passed for $PKGNAME $NEW_VER."
    echo "================================================="
    echo "Next steps for manual push:"
    echo "  cd $TARGET_DIR"
    echo "  git diff"
    echo "  git commit -am 'Update to $NEW_VER'"
    echo "  git push"
    echo "================================================="
else
    echo ""
    echo "================================================="
    echo "FAILED: Clean chroot build failed."
    echo "Review the output above to fix dependencies or PKGBUILD."
    echo "================================================="
    exit 1
fi
